{
  "name": "@landfill/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --watch --watch-path src src/interfaces/http/server.ts",
    "build": "esbuild src/interfaces/http/server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outbase=src --outdir=dist",
    "start": "node dist/interfaces/http/server.js",
    "check-types": "tsc --noEmit",
    "pretest": "npm run build --workspace @landfill/db",
    "test": "tsx --test src/interfaces/http/api.smoke.test.ts"
  },
  "keywords": [],
  "description": "",
  "license": "MIT",
  "dependencies": {
    "@landfill/db": "*",
    "archiver": "^8.0.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
